# Oneshot half of the browser-score experiment's runner (runner/run.py batch).
# One batch = RUNNER_PER_BATCH page loads (default 2), 2.5-4 min apart, arms in block-randomised order, under the
# runner's own daily budget (100 loads per UTC day) and the page's runner pool. Kill switch: touch runner/OFF
# (or $CAPTCHA_KILL_DIR/captcha-runner). Log: runner/state/runner.log and the journal.
# Install: symlink into ~/.config/systemd/user/; local paths live in ~/.config/captcha/env (see README).
[Unit]
Description=CAPTCHA browser-score experiment: one batch of page loads (runner/run.py)

[Service]
Type=oneshot
EnvironmentFile=%h/.config/captcha/env
ExecStart=/bin/sh -c 'cd "$CAPTCHA_ROOT/runner" && exec ./run.py batch'
TimeoutStartSec=25min
Nice=5
