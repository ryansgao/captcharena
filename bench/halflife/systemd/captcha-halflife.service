[Unit]
Description=CAPTCHA half-life clock: re-run the frozen sample and the bot detectors, recompute half-lives (bench/)
After=docker.service

[Service]
Type=oneshot
EnvironmentFile=%h/.config/captcha/env
ExecStart=/bin/sh -c 'exec "$CAPTCHA_ROOT/bench/halflife/weekly.sh"'
TimeoutStartSec=4h
Nice=10
