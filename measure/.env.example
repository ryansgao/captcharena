# Copy to .env for a local run. On the hosting server each value is set with `deploy-tool secret captcha-measure VAR <file>`.
# Vendor TEST keys (always pass, measure nothing) until the real keys exist:
RECAPTCHA_V2_SITE=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
RECAPTCHA_V2_SECRET=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe
TURNSTILE_SITE=1x00000000000000000000AA
TURNSTILE_SECRET=1x0000000000000000000000000000000AA
# reCAPTCHA v3 has no test key; it stays off until a real key exists.
RECAPTCHA_V3_SITE=
RECAPTCHA_V3_SECRET=
# Any long random string; signs our own ALTCHA challenges.
ALTCHA_HMAC_SECRET=
# Cap lane: dashboard login of the Cap server (>=32 random chars), its internal address, and a site key + secret
# made through its API on the box. Lane is off until all of CAP_URL, CAP_SITE, CAP_SECRET are set.
ADMIN_KEY=
CAP_URL=http://cap:3000
CAP_SITE=
CAP_SECRET=
